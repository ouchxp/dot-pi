{
  "lastChangelogVersion": "1.0.0",
  "theme": "dark",
  "defaultProvider": "commandcode",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "max",
  "defaultTools": [
    "+codemode"
  ],
  "collapseChangelog": true,
  "quietStartup": true,
  "shellCommandPrefix": "unset NODENV_VERSION",
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "no-tools",
  "hideThinkingBlock": false,
  "editorPaddingX": 1,
  "packages": [
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-btw",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-tool-display",
    "npm:pi-zentui",
    "https://github.com/ayghri/i-have-adhd",
    "npm:@byteowlz/pi-auto-rename",
    "npm:@ff-labs/pi-fff"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "delegate": {
        "model": "openai/gpt-6-luna",
        "thinking": "max"
      },
      "researcher": {
        "model": "openai/gpt-6-luna",
        "thinking": "max"
      },
      "worker": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "reviewer": {
        "model": "openai/gpt-6-astra",
        "thinking": "high",
        "timeoutMs": 7200000
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh",
        "timeoutMs": 7200000
      }
    },
    "watchdog": {
      "enabled": false,
      "main": {
        "enabled": false,
        "model": "openai/gpt-6-sol",
        "thinking": "xhigh"
      }
    }
  },
  "tuiMode": "regular",
  "transport": "auto",
  "forkContext": {
    "mode": "pruned",
    "model": "commandcode/deepseek/deepseek-v4.1-flash:low"
  },
  "deviceId": "564e4081-bb2c-4493-90a8-47fe623d5ff5",
  "extensions": []
}