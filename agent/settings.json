{
  "lastChangelogVersion": "0.84.4",
  "theme": "dark",
  "defaultProvider": "command-code",
  "defaultModel": "deepseek/deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "collapseChangelog": true,
  "quietStartup": true,
  "shellCommandPrefix": "unset NODENV_VERSION",
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "no-tools",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-btw",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-tool-display",
    "npm:pi-zentui",
    "https://github.com/ayghri/i-have-adhd",
    "npm:@byteowlz/pi-auto-rename",
    "npm:@ff-labs/pi-fff"
  ],
  "subagents": {
    "modelScope": {
      "agents": {
        "oracle": {
          "enforce": true,
          "allow": [
            "quotio-gpt/gpt-5.6-sol"
          ]
        }
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "command-code/deepseek/deepseek-v4-flash",
        "thinking": "max",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "ffgrep",
          "fffind",
          "module_report",
          "read_symbol",
          "read_enclosing"
        ]
      },
      "delegate": {
        "model": "quotio-gpt/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "researcher": {
        "model": "quotio-gpt/gpt-5.6-terra",
        "thinking": "high",
        "tools": [
          "read",
          "web_search",
          "fetch_content",
          "get_search_content"
        ]
      },
      "worker": {
        "model": "quotio-gpt/gpt-5.6-terra",
        "thinking": "xhigh"
      },
      "reviewer": {
        "model": "quotio-gpt/gpt-5.6-sol",
        "thinking": "xhigh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "ffgrep",
          "fffind",
          "module_report",
          "read_symbol",
          "read_enclosing"
        ],
        "timeoutMs": 7200000
      },
      "oracle": {
        "model": "quotio-gpt/gpt-5.6-sol",
        "thinking": "max",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "ffgrep",
          "fffind",
          "module_report",
          "read_symbol",
          "read_enclosing"
        ],
        "timeoutMs": 7200000
      }
    },
    "watchdog": {
      "enabled": false,
      "main": {
        "enabled": false,
        "model": "quotio-gpt/gpt-5.6-sol",
        "thinking": "xhigh"
      }
    }
  },
  "tuiMode": "regular",
  "transport": "auto",
  "forkContext": {
    "mode": "pruned",
    "model": "deepseek/deepseek-v4-flash:low"
  }
}