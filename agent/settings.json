{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "commandcode",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "max",
  "collapseChangelog": true,
  "quietStartup": true,
  "shellCommandPrefix": "unset NODENV_VERSION",
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "no-tools",
  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "packages": [
    "npm:pi-subagents@0.66.0",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-btw",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-tool-display",
    "npm:pi-zentui",
    "https://github.com/ayghri/i-have-adhd",
    "npm:@byteowlz/pi-auto-rename",
    "npm:@ff-labs/pi-fff"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "delegate": {
        "model": "tokenflux-gemini/gemini-3.8-flash-tiered",
        "thinking": "high"
      },
      "researcher": {
        "model": "tokenflux-gemini/gemini-3.8-flash-tiered",
        "thinking": "high"
      },
      "worker": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "medium",
        "timeoutMs": 7200000
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high",
        "timeoutMs": 7200000
      }
    },
    "watchdog": {
      "enabled": false,
      "main": {
        "enabled": false,
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "xhigh"
      }
    }
  },
  "tuiMode": "regular",
  "transport": "auto",
  "forkContext": {
    "mode": "pruned",
    "model": "deepseek/deepseek-v4.1-flash:low"
  }
}